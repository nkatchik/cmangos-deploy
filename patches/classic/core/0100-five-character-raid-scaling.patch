diff --git a/src/game/Globals/CustomRaidScaling.cpp b/src/game/Globals/CustomRaidScaling.cpp
new file mode 100644
index 000000000..32c660441
--- /dev/null
+++ b/src/game/Globals/CustomRaidScaling.cpp
@@ -0,0 +1,130 @@
+/*
+ * This file is part of the CMaNGOS Project. See AUTHORS file for Copyright information
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include "CustomRaidScaling.h"
+
+#include "Database/DatabaseEnv.h"
+#include "Log/Log.h"
+#include "World/World.h"
+
+#include <algorithm>
+
+CustomRaidScalingMgr& CustomRaidScalingMgr::Instance()
+{
+    static CustomRaidScalingMgr instance;
+    return instance;
+}
+
+uint64 CustomRaidScalingMgr::MakeKey(uint32 mapId, uint32 creatureEntry)
+{
+    return (uint64(mapId) << 32) | creatureEntry;
+}
+
+void CustomRaidScalingMgr::Load()
+{
+    m_scaling.clear();
+
+    if (!sWorld.getConfig(CONFIG_BOOL_CUSTOM_RAID_SCALING_ENABLED))
+    {
+        sLog.outString("Custom five-character raid scaling is disabled");
+        return;
+    }
+
+    std::unique_ptr<QueryResult> result(WorldDatabase.Query(
+        "SELECT map_id, creature_id, calibration_players, health_multiplier, damage_multiplier "
+        "FROM custom_raid_scaling"));
+
+    if (!result)
+    {
+        sLog.outErrorDb("Custom raid scaling is enabled, but `custom_raid_scaling` is missing or empty");
+        return;
+    }
+
+    BarGoLink bar(result->GetRowCount());
+    uint32 count = 0;
+    do
+    {
+        Field* fields = result->Fetch();
+        bar.step();
+
+        uint32 mapId = fields[0].GetUInt32();
+        uint32 creatureEntry = fields[1].GetUInt32();
+        CustomRaidScalingData data;
+        data.calibrationPlayers = fields[2].GetUInt32();
+        data.healthMultiplier = fields[3].GetFloat();
+        data.damageMultiplier = fields[4].GetFloat();
+
+        if (!data.calibrationPlayers || data.healthMultiplier <= 0.0f || data.damageMultiplier <= 0.0f)
+        {
+            sLog.outErrorDb(
+                "Invalid custom raid scaling row for map %u and creature %u; all multipliers and calibration_players must be positive",
+                mapId, creatureEntry);
+            continue;
+        }
+
+        m_scaling[MakeKey(mapId, creatureEntry)] = data;
+        ++count;
+    }
+    while (result->NextRow());
+
+    sLog.outString(">> Loaded %u custom raid scaling definitions for a target of %u character(s)",
+        count, sWorld.getConfig(CONFIG_UINT32_CUSTOM_RAID_SCALING_TARGET_PLAYERS));
+    sLog.outString();
+}
+
+CustomRaidScalingData const* CustomRaidScalingMgr::Find(uint32 mapId, uint32 creatureEntry) const
+{
+    auto itr = m_scaling.find(MakeKey(mapId, creatureEntry));
+    if (itr != m_scaling.end())
+        return &itr->second;
+
+    itr = m_scaling.find(MakeKey(mapId, 0));
+    return itr == m_scaling.end() ? nullptr : &itr->second;
+}
+
+float CustomRaidScalingMgr::AdjustForTargetPlayers(float multiplier, uint32 calibrationPlayers) const
+{
+    float targetPlayers = float(sWorld.getConfig(CONFIG_UINT32_CUSTOM_RAID_SCALING_TARGET_PLAYERS));
+    return std::min(1.0f, multiplier * targetPlayers / float(calibrationPlayers));
+}
+
+float CustomRaidScalingMgr::GetHealthMultiplier(uint32 mapId, uint32 creatureEntry) const
+{
+    CustomRaidScalingData const* data = Find(mapId, creatureEntry);
+    return data ? AdjustForTargetPlayers(data->healthMultiplier, data->calibrationPlayers) : 1.0f;
+}
+
+float CustomRaidScalingMgr::GetDamageMultiplier(uint32 mapId, uint32 creatureEntry) const
+{
+    CustomRaidScalingData const* data = Find(mapId, creatureEntry);
+    return data ? AdjustForTargetPlayers(data->damageMultiplier, data->calibrationPlayers) : 1.0f;
+}
+
+uint32 CustomRaidScalingMgr::GetMaxPlayers(uint32 mapId, uint32 configuredMaximum) const
+{
+    if (!IsEnabledForMap(mapId))
+        return configuredMaximum;
+
+    return std::min(configuredMaximum, sWorld.getConfig(CONFIG_UINT32_CUSTOM_RAID_SCALING_TARGET_PLAYERS));
+}
+
+bool CustomRaidScalingMgr::IsEnabledForMap(uint32 mapId) const
+{
+    return sWorld.getConfig(CONFIG_BOOL_CUSTOM_RAID_SCALING_ENABLED) &&
+        m_scaling.find(MakeKey(mapId, 0)) != m_scaling.end();
+}
+
+uint32 CustomRaidScalingMgr::GetMechanicCount(uint32 mapId, uint32 originalCount, uint32 fivePlayerCount) const
+{
+    if (!IsEnabledForMap(mapId))
+        return originalCount;
+
+    uint32 targetPlayers = sWorld.getConfig(CONFIG_UINT32_CUSTOM_RAID_SCALING_TARGET_PLAYERS);
+    return std::max(1u, (fivePlayerCount * targetPlayers + 4) / 5);
+}
diff --git a/src/game/Globals/CustomRaidScaling.h b/src/game/Globals/CustomRaidScaling.h
new file mode 100644
index 000000000..3f8286ed3
--- /dev/null
+++ b/src/game/Globals/CustomRaidScaling.h
@@ -0,0 +1,48 @@
+/*
+ * This file is part of the CMaNGOS Project. See AUTHORS file for Copyright information
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef CUSTOM_RAID_SCALING_H
+#define CUSTOM_RAID_SCALING_H
+
+#include "Common.h"
+
+#include <unordered_map>
+
+struct CustomRaidScalingData
+{
+    uint32 calibrationPlayers = 5;
+    float healthMultiplier = 1.0f;
+    float damageMultiplier = 1.0f;
+};
+
+class CustomRaidScalingMgr
+{
+    public:
+        static CustomRaidScalingMgr& Instance();
+
+        void Load();
+        float GetHealthMultiplier(uint32 mapId, uint32 creatureEntry) const;
+        float GetDamageMultiplier(uint32 mapId, uint32 creatureEntry) const;
+        uint32 GetMaxPlayers(uint32 mapId, uint32 configuredMaximum) const;
+        uint32 GetMechanicCount(uint32 mapId, uint32 originalCount, uint32 fivePlayerCount) const;
+
+    private:
+        using ScalingMap = std::unordered_map<uint64, CustomRaidScalingData>;
+
+        static uint64 MakeKey(uint32 mapId, uint32 creatureEntry);
+        CustomRaidScalingData const* Find(uint32 mapId, uint32 creatureEntry) const;
+        float AdjustForTargetPlayers(float multiplier, uint32 calibrationPlayers) const;
+        bool IsEnabledForMap(uint32 mapId) const;
+
+        ScalingMap m_scaling;
+};
+
+#define sCustomRaidScalingMgr CustomRaidScalingMgr::Instance()
+
+#endif

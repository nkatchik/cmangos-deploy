             m_instance->SetData(TYPE_GARR, IN_PROGRESS);
 
+        CreatureList firesworn;
+        GetCreatureListWithEntryInGrid(firesworn, m_creature, NPC_FIRESWORN, 100.0f);
+        uint32 kept = 0;
+        for (Creature* add : firesworn)

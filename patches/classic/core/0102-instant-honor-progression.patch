+void Player::CompactHonorHistory(uint32 beforeDate)
+{
+    for (HonorCPMap::iterator itr = m_honorCP.begin(); itr != m_honorCP.end();)
+    {
+        if (itr->date >= beforeDate)
+        {
+            ++itr;
+            continue;
+        }
+
+        if (itr->isKill)
+        {
+            if (itr->type == HONORABLE)
+                ++m_stored_honorableKills;
+            else if (itr->type == DISHONORABLE)
+                ++m_stored_dishonorableKills;
+        }
+
+        itr = m_honorCP.erase(itr);
+    }
+
+    UpdateHonor();
+}

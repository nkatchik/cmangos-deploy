+-- Keep raid bosses on a five-character encounter budget while making ordinary
+-- raid elites comparable to difficult dungeon elites. This lets a well-geared
+-- level-60 character defeat one isolated elite without making a full trash
+-- pack or a raid boss solo content.
+
+ALTER TABLE `custom_raid_scaling`
+  ADD COLUMN `boss_health_multiplier` float unsigned NOT NULL DEFAULT '1' AFTER `damage_multiplier`,
+  ADD COLUMN `boss_damage_multiplier` float unsigned NOT NULL DEFAULT '1' AFTER `boss_health_multiplier`;
+
+-- Existing creature-specific overrides are boss/encounter overrides. Preserve
+-- their values before assigning distinct map-level trash and boss budgets.
+UPDATE `custom_raid_scaling`
+SET `boss_health_multiplier` = `health_multiplier`,
+    `boss_damage_multiplier` = `damage_multiplier`;
+
+UPDATE `custom_raid_scaling`
+SET `health_multiplier` = 0.12,
+    `damage_multiplier` = 0.40,
+    `boss_health_multiplier` = 0.20,
+    `boss_damage_multiplier` = 0.55,
+    `comment` = 'Onyxia raid trash and boss defaults'
+WHERE `map_id` = 249 AND `creature_id` = 0;
+
+UPDATE `custom_raid_scaling`
+SET `health_multiplier` = 0.22,
+    `damage_multiplier` = 0.45,
+    `boss_health_multiplier` = 0.35,
+    `boss_damage_multiplier` = 0.65,
+    `comment` = 'Zul''Gurub raid trash and boss defaults'
+WHERE `map_id` = 309 AND `creature_id` = 0;
+
+UPDATE `custom_raid_scaling`
+SET `health_multiplier` = 0.12,
+    `damage_multiplier` = 0.40,
+    `boss_health_multiplier` = 0.20,
+    `boss_damage_multiplier` = 0.55,
+    `comment` = 'Molten Core raid trash and boss defaults'
+WHERE `map_id` = 409 AND `creature_id` = 0;
+
+UPDATE `custom_raid_scaling`
+SET `health_multiplier` = 0.12,
+    `damage_multiplier` = 0.40,
+    `boss_health_multiplier` = 0.20,
+    `boss_damage_multiplier` = 0.55,
+    `comment` = 'Blackwing Lair raid trash and boss defaults'
+WHERE `map_id` = 469 AND `creature_id` = 0;
+

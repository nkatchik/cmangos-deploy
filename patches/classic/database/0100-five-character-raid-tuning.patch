+  `map_id` smallint unsigned NOT NULL,
+  `creature_id` mediumint unsigned NOT NULL DEFAULT '0',
+  `calibration_players` tinyint unsigned NOT NULL DEFAULT '5',
+  `health_multiplier` float unsigned NOT NULL DEFAULT '1',
+  `damage_multiplier` float unsigned NOT NULL DEFAULT '1',
+  `comment` varchar(255) NOT NULL DEFAULT '',
+  PRIMARY KEY (`map_id`, `creature_id`)
+) ENGINE=MyISAM DEFAULT CHARSET=utf8mb3 COMMENT='Custom five-character raid scaling';
